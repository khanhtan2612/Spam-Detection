{
  "seed": 42,
  "split": [
    0.7,
    0.15,
    0.15
  ],
  "tfidf": {
    "max_features": 1000,
    "min_df": 2,
    "token_pattern": "\\b\\w\\w+\\b",
    "tf": "1 + log f",
    "idf": "log((1+N)/(1+df)) + 1",
    "norm": "l2"
  },
  "decomposition": {
    "k_values": [
      10,
      50,
      100
    ],
    "method": "orthogonal iteration",
    "tol": 1e-08,
    "max_iter": 5000
  },
  "logistic_regression": {
    "lambda": 1.0,
    "learning_rate": 2.0,
    "max_epochs": 20000,
    "tol": 1e-10,
    "threshold": 0.5
  },
  "selection": "validation macro-F1 cao nhất; bằng nhau thì lấy k nhỏ hơn",
  "python": "3.14.7",
  "numpy": "2.5.4",
  "pandas": "3.0.6"
}